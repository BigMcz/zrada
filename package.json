{
  "name": "zrada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zrada – společenská hra na telefonech pro místní síť",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared --watch-preserve-output --import tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
